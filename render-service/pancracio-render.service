[Unit]
Description=Pancracio Render Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pancracio-render/render-service
ExecStart=/root/pancracio-render/render-service/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8090
Restart=on-failure

[Install]
WantedBy=multi-user.target
