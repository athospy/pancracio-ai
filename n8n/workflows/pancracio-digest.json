    {
      "id": "d1a1b1c1-0003-4a1a-8a1a-000000000003",
      "name": "Build Digest Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// GET /api/ideas?auto_publish=true returns a JSON array, but the HTTP Request node auto-splits\n// a top-level array response into one n8n item per idea (confirmed empirically: 4 ideas -> 4\n// items on this node) -- same version-dependent behavior auto-publish.json's own \"Split Into\n// Ideas\" node comment warns about. So reconstruct the full array from all input items rather\n// than assuming $input.first().json is the array itself.\nconst ideas = $input.all().map((item) => item.json);\nconst pending = ideas.filter((i) => i.status === \"idea\");\npending.sort((a, b) => (a.scheduled_at || \"\").localeCompare(b.scheduled_at || \"\"));\nconst next = pending[0] || null;\n\nconst subject = next ? \"Pancracio: next up\" : \"Pancracio: nothing queued\";\nconst bodyHtml = next\n  ? `<html><body><h2>Next up</h2><p><strong>${next.title}</strong></p><p>${next.quote_line || \"\"}</p><p>Scheduled: ${next.scheduled_at || \"as soon as it's due\"}</p></body></html>`\n  : `<html><body><h2>Nothing queued</h2><p>No auto-publish ideas are currently pending.</p></body></html>`;\n\nreturn [{ json: { subject, html: bodyHtml } }];\n"
      }
    },
    {
      "id": "d1a1b1c1-0004-4a1a-8a1a-000000000004",
      "name": "Send Digest Email",
      "type": "n8n-nodes-base.httpRequest",
