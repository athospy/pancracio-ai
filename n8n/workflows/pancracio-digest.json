      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: \"Pancracio Monitoring <pancracio@notify.santiagomorel.dev>\", to: [\"santi.morel@gmail.com\"], subject: $json.subject, html: $json.html } }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "YWKHMHD0TNtFNyGS",
          "name": "Resend API Key"
        }
      }
    }
