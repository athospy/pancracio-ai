      "parameters": {
        "jsCode": "// GET /api/ideas?due=true returns a JSON array in the response body. Explicitly\n// split it into one n8n item per idea, rather than relying on the HTTP Request\n// node's version-dependent auto-splitting of array responses.\nconst body = $input.first().json;\nconst ideas = Array.isArray(body) ? body : [];\nreturn ideas.map((idea) => ({ json: idea }));"
      }
