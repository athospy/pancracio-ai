            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "f1a1b1c1-0002-4a1a-8a1a-000000000002",
      "name": "Get Due Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://pancracio-ideas.santiagomorel.dev/api/ideas",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "due",
              "value": "true"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "F8WOkbGlhwKzrIOd",
          "name": "Pancracio Tracker Bearer Token"
        }
      }
    },
    {
      "id": "f1a1b1c1-0004-4a1a-8a1a-000000000004",
      "name": "Split Into Ideas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst ideas = [];\nfor (const item of inputItems) {\n  if (Array.isArray(item.json)) {\n    ideas.push(...item.json);\n  } else {\n    ideas.push(item.json);\n  }\n}\nreturn ideas.map((idea) => ({ json: idea }));"
      }
    },
    {
      "id": "f1a1b1c1-0003-4a1a-8a1a-000000000003",
      "name": "Run Pipeline For Idea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://pancracio-ideas.santiagomorel.dev/internal/run-pipeline/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 180000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "F8WOkbGlhwKzrIOd",
          "name": "Pancracio Tracker Bearer Token"
        }
      }
    },
    {
      "id": "f1a1b1c1-0005-4a1a-8a1a-000000000005",
      "name": "Get Current Idea Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pancracio-ideas.santiagomorel.dev/api/ideas/{{ $('Split Into Ideas').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "F8WOkbGlhwKzrIOd",
          "name": "Pancracio Tracker Bearer Token"
        }
      }
    },
    {
      "id": "f1a1b1c1-0006-4a1a-8a1a-000000000006",
      "name": "Alert If Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b1c1d1e1-0001-4a1a-8a1a-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f1a1b1c1-0007-4a1a-8a1a-000000000007",
      "name": "Send Failure Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
