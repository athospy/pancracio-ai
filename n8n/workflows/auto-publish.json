        "url": "https://api.resend.com/emails",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: \"Pancracio Monitoring <pancracio@notify.santiagomorel.dev>\", to: [\"santi.morel@gmail.com\"], subject: \"Pancracio: pipeline failed on \\\"\" + $json.title + \"\\\"\", html: \"<html><body><h2>Pipeline failure</h2><p>Idea <strong>\" + $json.title + \"</strong> (id \" + $json.id + \") failed during auto-publish.</p><p>Check the tracker for details.</p></body></html>\" } }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
